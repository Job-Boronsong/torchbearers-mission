@admin.register(CarouselSlide)
class CarouselSlideAdmin(SortableAdminMixin, admin.ModelAdmin):
    list_display = ("image_preview", "title", "is_active")
    list_editable = ("is_active",)
    readonly_fields = ("image_preview",)
    ordering = ("order",)

    def image_preview(self, obj):
        if obj.image:
            return format_html(
                '<img src="{}" style="height:80px; border-radius:6px;" />',
                obj.image.url,
            )
        return "No Image"


@admin.register(LoginAudit)
class LoginAuditAdmin(admin.ModelAdmin):
    list_display = ("user", "ip_address", "successful", "timestamp")
    list_filter = ("successful", "timestamp")


@admin.action(description="Export active subscribers (CSV)")
def export_newsletter_csv(modeladmin, request, queryset):
    response = HttpResponse(content_type="text/csv")
    response["Content-Disposition"] = 'attachment; filename="newsletter_subscribers.csv"'

    writer = csv.writer(response)
    writer.writerow(["Email", "Subscribed At"])

    for sub in queryset.filter(is_active=True):
        writer.writerow([sub.email, sub.subscribed_at])

    return response


@admin.action(description="Send newsletter email")
def send_newsletter(modeladmin, request, queryset):
    sent = 0

    for sub in queryset.filter(is_active=True):

        # 🔹 ITEM E — unsubscribe link
        unsubscribe_url = request.build_absolute_uri(
            reverse("newsletter_unsubscribe", args=[sub.unsubscribe_token])
        )

        send_mail(
            subject="Torchbearers Mission Incorporated Newsletter",
            message=(
                "Hello,\n\n"
                "Thank you for being part of Torchbearers Mission Incorporated.\n\n"
                "God bless you,\n"
                "Torchbearers Mission Incorporated\n\n"
                f"Unsubscribe here: {unsubscribe_url}"
            ),
            from_email=settings.DEFAULT_FROM_EMAIL,
            recipient_list=[sub.email],
            fail_silently=False,
        )

        sent += 1

    messages.success(request, f"{sent} newsletter emails sent.")


@admin.action(des


@admin.register(NewsletterSubscriber)
class NewsletterSubscriberAdmin(admin.ModelAdmin):
    list_display = ("email", "subscribed_at", "is_active")
    search_fields = ("email",)
    list_filter = ("is_active",)
    actions = [
        export_newsletter_csv,
        send_newsletter,
    ]


@admin.action(description="Send HTML newsletter")
def send_html_newsletter(modeladmin, request, queryset):
    sent = 0

    for sub in queryset.filter(is_active=True):

        unsubscribe_url = request.build_absolute_uri(
            reverse("newsletter_unsubscribe", args=[sub.unsubscribe_token])
        )

        subject = "Torchbearers Mission Incorporated Newsletter"

        context = {
            "subject": subject,
            "message": (
                "Thank you for partnering with Torchbearers Mission Incorporated. "
                "We are grateful for your prayers and support."
            ),
            "unsubscribe_url": unsubscribe_url,
            "year": datetime.now().year,
        }

        html_content = render_to_string("emails/newsletter.html", context)
        text_content = (
            "Torchbearers Mission Incorporated Newsletter\n\n"
            "Thank you for partnering with us.\n\n"
            f"Unsubscribe: {unsubscribe_url}"
        )

        email = EmailMultiAlternatives(
            subject=subject,
            body=text_content,
            from_email=settings.DEFAULT_FROM_EMAIL,
            to=[sub.email],
        )
        email.attach_alternative(html_content, "text/html")
        email.send()

        sent += 1

    messages.success(request, f"{sent} HTML newsletters sent successfully.")


@admin.register(Newsletter)
class NewsletterAdmin(admin.ModelAdmin):
    list_display = ("subject", "created_at", "sent")
    readonly_fields = ("created_at",)
    actions = ["send_newsletter_action"]

    def send_newsletter_action(self, request, queryset):
        newsletter = queryset.first()
        subscribers = NewsletterSubscriber.objects.filter(is_active=True)

        sent = 0

        for sub in subscribers:
            msg = EmailMultiAlternatives(
                subject=newsletter.subject,
                body="Your email client does not support HTML.",
                from_email=settings.DEFAULT_FROM_EMAIL,
                to=[sub.email],
            )

            msg.attach_alternative(newsletter.html_content, "text/html")
            msg.send()
            sent += 1

        newsletter.sent = True
        newsletter.save()

        messages.success(request, f"{sent} newsletters sent successfully.")

    send_newsletter_action.short_description = "Send selected newsletter"

